# 反向代理示例：放到 /etc/nginx/conf.d/food-map.conf
# 需要把域名和证书路径换成你自己的

server {
    listen 80;
    server_name food.example.edu.cn;
    # 全站强制 HTTPS（登录 Cookie 在 https 下才会带 Secure）
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;

    server_name food.example.edu.cn;

    ssl_certificate     /etc/letsencrypt/live/food.example.edu.cn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/food.example.edu.cn/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # 图片以 base64 存在 JSON 里，请求体可能较大
    client_max_body_size 45m;
    client_body_timeout  60s;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 实时推送必须关闭缓冲，否则其他设备收不到更新
    location /api/events {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Connection        "";
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
    }
}
